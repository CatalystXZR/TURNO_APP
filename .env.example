# ─────────────────────────────────────────────────────────────
# Turno — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to git. ONLY FOR LOCAL USE.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # Never expose in Flutter app

# ── Fintoc ────────────────────────────────────────────────────
# Found in: https://app.fintoc.com → API Keys (modo Test)
# PENDIENTE DE OBTENER — pedir al dueño de la cuenta Fintoc:
FINTOC_SECRET_KEY=sk_test_YOUR_SECRET_KEY          # Secret key de TEST (sandbox)
FINTOC_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY          # No requerida para Checkout Sessions
FINTOC_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET          # Se genera al registrar el webhook en el dashboard
# Webhook URL a registrar en Fintoc Dashboard:
#   https://<PROJECT_REF>.supabase.co/functions/v1/fintoc-webhook

# ── App ───────────────────────────────────────────────────────
# The public HTTPS URL where your app is accessible
APP_BASE_URL=https://URL.CL # NOT DEFINED

# ── Payment Provider ──────────────────────────────────────────
# Options: fintoc, disabled
PAYMENT_PROVIDER=fintoc

# ── Push Notifications (APNs) ─────────────────────────────────
# Found in: Apple Developer Console → Keys
APNS_KEY_ID=YOUR_KEY_ID
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_BUNDLE_ID=cl.turnoapp.mobile
APNS_KEY_BASE64=YOUR_KEY_BASE64
INTERNAL_PUSH_SECRET=YOUR_RANDOM_SECRET

# ── Flutter build (passed via --dart-define) ──────────────────
# flutter build ios --release \
#   --dart-define=SUPABASE_URL=$SUPABASE_URL \
#   --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
